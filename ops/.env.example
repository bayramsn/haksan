# Haksan Ops runtime settings. Copy to ops/.env on the server.

# Master switches
OPS_ENABLED=true
OPS_ACTIONS_ENABLED=false
OPS_DEPLOY_ENABLED=false
OPS_EXECUTOR=local
OPS_DRY_RUN=false

# Local-only ops console
OPS_HOST=127.0.0.1
OPS_PORT=3900
# Generate with: openssl rand -hex 32
OPS_CONSOLE_TOKEN=
# Generate with: openssl rand -hex 32
OPS_HMAC_SECRET=
OPS_ACTION_TTL_MINUTES=60
OPS_ACTION_TIMEOUT_SECONDS=900
OPS_AUDIT_MAX_BYTES=5242880

# Production endpoint used by smoke checks and reports.
OPS_PUBLIC_BASE_URL=https://crm.example.com

# Docker Compose / repo
OPS_APP_ROOT=/opt/haksan
OPS_ENV_FILE=.env
OPS_STATE_DIR=/opt/haksan/ops/state

# Thresholds
OPS_DISK_WARN_PCT=85
OPS_DISK_CRIT_PCT=92
OPS_BACKUP_MAX_AGE_HOURS=26
OPS_LOG_WINDOW_LINES=1000

# Telegram
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_CHAT_IDS=
OPS_TELEGRAM_ALLOWED_USERS=
OPS_TELEGRAM_POLL_INTERVAL_MS=2500
