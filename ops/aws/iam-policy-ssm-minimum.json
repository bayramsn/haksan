{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunOnlyHaksanOpsDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:document/HaksanOpsWhitelistedAction",
        "arn:aws:ec2:REGION:ACCOUNT_ID:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/App": "haksan-crm",
          "ssm:resourceTag/Role": "prod"
        }
      }
    },
    {
      "Sid": "ReadCommandResults",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "ssm:ListCommands"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTaggedInstanceMetadata",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceStatus",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics"
      ],
      "Resource": "*"
    }
  ]
}
