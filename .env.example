# Haksan production env example for Docker Compose on EC2.
# Copy to .env on the server and replace every CHANGE_ME value.
# Do not commit real .env files.
#
# Generate secrets:
#   openssl rand -hex 32

APP_DOMAIN=crm.example.com
STORAGE_DOMAIN=storage.example.com
# Use a real email for production. For temporary sslip.io tests, `none` is allowed.
CERTBOT_EMAIL=admin@example.com
VITE_API_BASE_URL=/api/v1

NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

POSTGRES_DB=haksan
POSTGRES_USER=haksan
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD_32_CHARS_MIN
DATABASE_URL=postgres://haksan:CHANGE_ME_POSTGRES_PASSWORD_32_CHARS_MIN@postgres:5432/haksan
DB_PROVIDER=postgres
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# Docker private network/self-hosted Postgres. Use DATABASE_SSL=true for managed DBs.
DATABASE_ALLOW_PLAINTEXT=true

CORS_ORIGINS=https://crm.example.com
COOKIE_DOMAIN=crm.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_SECRET=CHANGE_ME_COOKIE_SECRET_OPENSSL_RAND_HEX_32

JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_OPENSSL_RAND_HEX_32
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_OPENSSL_RAND_HEX_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PUBLIC_LINK_SECRET=CHANGE_ME_PUBLIC_LINK_SECRET_OPENSSL_RAND_HEX_32

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=5
TRUST_PROXY_HOPS=1

CHAT_REALTIME_ENABLED=true
CALL_WEBHOOK_SECRET=CHANGE_ME_CALL_WEBHOOK_SECRET_32_CHARS_MIN
ASSISTANT_LLM_PROVIDER=none
ASSISTANT_MODEL=openrouter/free
ASSISTANT_API_KEY=
ASSISTANT_MAX_TOKENS=700

MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY_32_CHARS_MIN
MINIO_CONSOLE_PORT=9001

S3_PROVIDER=minio
S3_ENDPOINT=https://storage.example.com
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_SECRET_KEY_32_CHARS_MIN
S3_BUCKET_PREFIX=erp
S3_FORCE_PATH_STYLE=true

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

MAX_UPLOAD_SIZE_MB=25
SIGNED_URL_EXPIRE_SECONDS=300

RESET_TOKEN_TTL_MINUTES=60
AUTH_DEV_RESET_TOKEN_RESPONSE=false

# Use a real SMTP provider in production. Do not use Mailhog.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=noreply@example.com

# Optional observability.
SENTRY_DSN=
OTEL_SERVICE_NAME=haksan-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN_OPENSSL_RAND_HEX_32

GIT_COMMIT=
BUILD_TIME=
