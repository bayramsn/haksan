{
  "name": "haksan",
  "private": true,
  "version": "0.1.0",
  "description": "CNC ERP/CRM monorepo — backend (NestJS) + frontend (React/Vite) + shared types",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @haksan/web run dev",
    "dev:api": "npm --workspace @haksan/api run dev",
    "dev:mobile": "npm --workspace @haksan/mobile run start",
    "android:mobile": "npm --workspace @haksan/mobile run android",
    "build:web": "npm --workspace @haksan/web run build",
    "build:api": "npm --workspace @haksan/api run build",
    "build:shared": "npm --workspace @haksan/shared run build",
    "typecheck:mobile": "npm --workspace @haksan/mobile run typecheck",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "typecheck": "npm --workspace @haksan/api run typecheck",
    "audit:contracts": "npm --workspace @haksan/api run audit:contracts",
    "lint:migrations": "npm --workspace @haksan/api run db:lint:migrations",
    "test:coverage": "npm --workspace @haksan/api run test:coverage",
    "db:generate": "npm --workspace @haksan/api run db:generate",
    "db:migrate": "npm --workspace @haksan/api run db:migrate",
    "db:seed": "npm --workspace @haksan/api run db:seed",
    "db:seed:lookups": "npm --workspace @haksan/api run db:seed:lookups",
    "db:seed:demo": "npm --workspace @haksan/api run db:seed:demo",
    "db:bootstrap": "npm --workspace @haksan/api run db:bootstrap",
    "test": "npm --workspace @haksan/api run test",
    "test:e2e": "npm --workspace @haksan/web run test:e2e",
    "test:e2e:install": "npm --workspace @haksan/web run test:e2e:install",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@expo/config-plugins": "^56.0.9"
  }
}
