{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@haksan/web", "run", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@haksan/api", "run", "start"],
      "port": 3000
    },
    {
      "name": "web-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@haksan/web", "exec", "--", "vite", "--host", "127.0.0.1", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "web-prod-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@haksan/web", "exec", "--", "vite", "preview", "--host", "127.0.0.1", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "stitch-html",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8799", "--directory", ".stitch/download/html"],
      "port": 8799
    }
  ]
}
