{
  "cli": {
    "version": ">= 22.2.0 < 23.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "22.22.3"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "preview-simulator": {
      "extends": "base",
      "environment": "preview",
      "channel": "preview",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle",
        "env": {
          "HAKSAN_ANDROID_STORE_BUILD": "1",
          "EXPO_PUBLIC_API_URL": "https://d3n1sxxvasfqmv.cloudfront.net/api/v1",
          "EXPO_PUBLIC_APP_LINK_HOST": "d3n1sxxvasfqmv.cloudfront.net"
        }
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6824463173"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
