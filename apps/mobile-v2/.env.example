# Public build-time configuration. Never put secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
EXPO_PUBLIC_APP_LINK_HOST=app.example.com
# Android firma haritası için Google Maps Android SDK anahtarı. Bu bir mobil
# istemci anahtarıdır; Google Cloud'da package + SHA-1 ile sıkı kısıtlanmalıdır.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# EAS project metadata; configure the real value in the EAS environment.
EAS_PROJECT_ID=

# Runtime telemetry. DSN is intentionally public; source-map upload credentials
# (`SENTRY_AUTH_TOKEN`) belong only in the EAS secret store and never in this file.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=production
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ORG=
SENTRY_PROJECT=

# Set false only when the API realtime gateway is intentionally disabled.
EXPO_PUBLIC_CHAT_REALTIME=true
