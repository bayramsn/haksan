{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      { "include": "db/migrations/**/*.sql", "outDir": "dist", "watchAssets": false },
      { "include": "db/migrations/**/*.json", "outDir": "dist", "watchAssets": false }
    ]
  }
}
