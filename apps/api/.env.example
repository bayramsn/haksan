# Backend env (NestJS + Drizzle)
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DB_PROVIDER=postgres
DATABASE_URL=postgres://haksan:haksan_dev_pwd@localhost:5432/haksan
DATABASE_POOL_MAX=10

# CORS allowlist (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Cookie / session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# JWT
JWT_ACCESS_SECRET=change-me-access-development-only-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-development-only-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Auth lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Rate limit (per minute)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_LOGIN=5

# Gerçek-zaman sohbet ve farklı ağlardaki WebRTC aramaları.
CHAT_REALTIME_ENABLED=true
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
WEBRTC_TURN_TTL_SECONDS=3600

# Storage
S3_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# AWS S3 production: credentials boş, S3_BUCKET_NAME hesap-özel fiziksel bucket.
S3_BUCKET_NAME=
S3_BUCKET_PREFIX=erp
S3_FORCE_PATH_STYLE=true

# Supabase (only used when S3_PROVIDER=supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Upload constraints
MAX_UPLOAD_SIZE_MB=25
SIGNED_URL_EXPIRE_SECONDS=300

# Password reset
RESET_TOKEN_TTL_MINUTES=60
# Development/test only. Keep false/unset on any real server.
AUTH_DEV_RESET_TOKEN_RESPONSE=false

# Mail (Mailhog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@haksan.local

# Kullanıcıların kendi kurumsal webmail adresiyle gönderim yapması.
# SMTP sunucusu backend'de sabittir; kullanıcı yalnız e-posta + webmail şifresi girer.
USER_MAIL_ENABLED=true
USER_MAIL_SMTP_HOST=mail.haksancnc.com.tr
USER_MAIL_SMTP_PORT=587
USER_MAIL_SMTP_SECURE=false
USER_MAIL_ALLOWED_EMAIL_DOMAINS=haksancnc.com.tr
# Üretmek için: openssl rand -base64 32
USER_MAIL_CREDENTIAL_ENCRYPTION_KEY=

# Zamanlanmış otomasyon (sabah brifingi, vade/garanti/teklif hatırlatmaları)
AUTOMATION_ENABLED=true
AUTOMATION_TIMEZONE=Europe/Istanbul
AUTOMATION_STALE_QUOTE_DAYS=7
AUTOMATION_WARRANTY_WINDOW_DAYS=30
# Sabah özetini e-posta ile de göndermek için (SMTP yapılandırması gerekir):
AUTOMATION_DIGEST_EMAILS=false
# AUTOMATION_DIGEST_TO=yonetim@firma.com,satis@firma.com

# OSM firma/adres araması yalnız backend üzerinden yapılır.
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# ── Observability (opt-in — boş bırakılırsa devre dışı) ──
# Sentry: https://sentry.io → Project Settings → Client Keys (DSN)
# SENTRY_DSN=
# OpenTelemetry traces (Grafana Cloud, Honeycomb, Jaeger OTLP/HTTP):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.example.com/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20YOUR_TOKEN
# OTEL_SERVICE_NAME=haksan-api
# Prometheus /metrics koruması (opsiyonel; boş = açık endpoint)
# METRICS_TOKEN=

# ── Pre-deploy DB backup (pg_dump → S3/R2) ──
# VDS'te postgresql-client kurulu olmalı. Render'da pg_dump yoksa no-op olur.
# DB_BACKUP_ENABLED=false
# DB_BACKUP_REQUIRED=false
# S3_BACKUP_BUCKET=erp-backups

# Güvenlik sıkılaştırma (oturum 2026-06-26)
COOKIE_SECRET=
DATABASE_ALLOW_PLAINTEXT=false
RATE_LIMIT_UPLOAD=5
TRUST_PROXY_HOPS=1
