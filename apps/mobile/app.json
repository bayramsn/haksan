{
  "expo": {
    "name": "Haksan CRM",
    "slug": "haksan-crm-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "haksan",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.haksan.mobile"
    },
    "android": {
      "package": "com.haksan.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#000c69",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000c69"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yakındaki firmaları haritada göstermek için konum izni gerekir."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Servis ve kurulum fotoğrafları için galeri erişimi gerekir.",
          "cameraPermission": "Saha fotoğrafları için kamera erişimi gerekir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  }
}
