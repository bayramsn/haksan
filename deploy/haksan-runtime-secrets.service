[Unit]
Description=Fetch Haksan production runtime environment from AWS Secrets Manager
Wants=network-online.target
After=network-online.target
Before=docker.service haksan-aws-backup.service haksan-cert-renew.service

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=haksan
RuntimeDirectoryMode=0700
Environment=AWS_REGION=eu-central-1
Environment=HAKSAN_RUNTIME_SECRET_ID=arn:aws:secretsmanager:eu-central-1:866490183348:secret:haksan/prod/runtime-env-2THjJn
ExecStart=/usr/local/sbin/fetch-haksan-runtime-env
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/haksan
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
