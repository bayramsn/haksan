[Unit]
Description=Haksan PostgreSQL backup to AWS S3
After=network-online.target docker.service haksan-runtime-secrets.service
Wants=network-online.target
Requires=docker.service haksan-runtime-secrets.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/haksan
Environment=APP_ROOT=/opt/haksan
Environment=AWS_REGION=eu-central-1
Environment=AWS_BACKUP_BUCKET=haksan-prod-backups-866490183348-eu-central-1
Environment=INSTANCE_ID=i-0fac9a4d4eca0cf13
ExecStart=/opt/haksan/deploy/aws-backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/haksan/backups
