# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION env örneği — apps/api/.env olarak kopyala ve doldur.
# Bu dosyayı GIT'e EKLEME. Secret'ları bir secret manager'da tut.
#
# Secret üret:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ── Database ──
# Runtime kullanıcısı minimum yetkili olsun; migration için ayrı kullanıcı kullan.
DB_PROVIDER=postgres
DATABASE_URL=postgres://haksan_app:CHANGE_ME_STRONG_PWD@127.0.0.1:5432/haksan
DATABASE_POOL_MAX=10
# Managed Postgres (Supabase/RDS/Azure) kullanıyorsan true yap. Self-hosted/docker'da false.
DATABASE_SSL=false

# ── CORS ── (SADECE prod domain; localhost YASAK — yoksa boot başarısız olur)
CORS_ORIGINS=https://crm.alanadi.com

# ── Cookie / session ── (production'da COOKIE_SECURE=true ZORUNLU)
# Aynı-origin topolojide (SPA + API aynı domain) 'strict' en güvenlisidir.
# Farklı subdomain kullanıyorsan 'none' + COOKIE_DOMAIN=.alanadi.com gerekir.
COOKIE_DOMAIN=crm.alanadi.com
COOKIE_SECURE=true
COOKIE_SAMESITE=strict

# ── JWT ── (her biri ≥32 char, openssl rand -hex 32 ile üret)
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32_access
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Auth lockout ──
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── Rate limit (dakika başına) ── prod'da daha sıkı önerilir
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LOGIN=5

# ── Storage ──
# S3_ENDPOINT tarayıcıdan ERİŞİLEBİLİR public URL olmalı (presigned URL'ler
# tarayıcıya bu host ile döner). MinIO'yu storage.alanadi.com'dan proxy'le.
S3_PROVIDER=minio
S3_ENDPOINT=https://storage.alanadi.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
S3_BUCKET_PREFIX=erp
S3_FORCE_PATH_STYLE=true

# (S3_PROVIDER=supabase/s3/r2 ise ilgili anahtarları doldur)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Upload ──
MAX_UPLOAD_SIZE_MB=25
SIGNED_URL_EXPIRE_SECONDS=300

# ── Password reset ── (prod'da MUTLAKA false)
RESET_TOKEN_TTL_MINUTES=60
AUTH_DEV_RESET_TOKEN_RESPONSE=false

# ── Mail ── (GERÇEK SMTP — mailhog DEĞİL)
SMTP_HOST=smtp.alanadi.com
SMTP_PORT=587
SMTP_FROM=noreply@alanadi.com

# ─────────────────────────────────────────────────────────────────────────
# FRONTEND (build anında, apps/web): SPA derlenirken set EDİLMELİ —
# çalışma anında değil. Örn:
#   VITE_API_BASE_URL=https://crm.alanadi.com/api/v1 npm run build:web
# ─────────────────────────────────────────────────────────────────────────
