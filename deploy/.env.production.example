# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION env örneği — apps/api/.env olarak kopyala ve doldur.
# Bu dosyayı GIT'e EKLEME. Secret'ları bir secret manager'da tut.
#
# Secret üret:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production
DEPLOYMENT_PROFILE=production
PORT=3000
API_PREFIX=/api/v1

# Opsiyonel — deploy-vds.sh otomatik yazar
GIT_COMMIT=
BUILD_TIME=
# Runtime kullanıcısı minimum yetkili olsun; migration için ayrı kullanıcı kullan.
DB_PROVIDER=postgres
DATABASE_URL=postgres://haksan_app:CHANGE_ME_STRONG_PWD@127.0.0.1:5432/haksan
DATABASE_POOL_MAX=10
# Managed Postgres (Supabase/RDS/Azure) kullanıyorsan true yap. Self-hosted/docker'da false.
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Private-network/self-hosted PostgreSQL kullanılıyorsa bu istisnayı açıkça belirt.
DATABASE_ALLOW_PLAINTEXT=true

# ── CORS ── (SADECE prod domain; localhost YASAK — yoksa boot başarısız olur)
CORS_ORIGINS=https://crm.alanadi.com

# ── Cookie / session ── (production'da COOKIE_SECURE=true ZORUNLU)
# Aynı-origin topolojide (SPA + API aynı domain) 'strict' en güvenlisidir.
# Farklı subdomain kullanıyorsan 'none' + COOKIE_DOMAIN=.alanadi.com gerekir.
COOKIE_DOMAIN=crm.alanadi.com
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
COOKIE_SECRET=CHANGE_ME_openssl_rand_hex_32_cookie

# ── JWT ── (her biri ≥32 char, openssl rand -hex 32 ile üret)
JWT_ACCESS_SECRET=CHANGE_ME_openssl_rand_hex_32_access
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_32_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CALL_WEBHOOK_SECRET=CHANGE_ME_CALL_WEBHOOK_SECRET_32_CHARS_MIN
CHAT_REALTIME_ENABLED=true
# coturn REST secret'ı backend-only'dir. Örn: turn:turn.alanadi.com:3478
WEBRTC_TURN_URLS=
WEBRTC_TURN_SHARED_SECRET=
WEBRTC_TURN_TTL_SECONDS=3600

# ── Auth lockout ──
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── Rate limit (dakika başına) ── prod'da daha sıkı önerilir
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=5
TRUST_PROXY_HOPS=1

# ── AI assistant / NVIDIA NIM ── (API key sadece backend'de tutulur)
ASSISTANT_LLM_PROVIDER=nvidia
ASSISTANT_MODEL=qwen/qwen3-next-80b-a3b-instruct
ASSISTANT_API_KEY=
ASSISTANT_MAX_TOKENS=700
ASSISTANT_TEMPERATURE=0.2
ASSISTANT_TOP_P=0.8
ASSISTANT_DAILY_TOKEN_BUDGET=50000

# ── Storage ──
# S3_ENDPOINT tarayıcıdan ERİŞİLEBİLİR public URL olmalı (presigned URL'ler
# tarayıcıya bu host ile döner). MinIO'yu storage.alanadi.com'dan proxy'le.
S3_PROVIDER=minio
S3_ENDPOINT=https://storage.alanadi.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=CHANGE_ME_minio_access_key
S3_SECRET_ACCESS_KEY=CHANGE_ME_minio_secret_key
S3_BUCKET_PREFIX=erp
S3_FORCE_PATH_STYLE=true
S3_BACKUP_BUCKET=erp-backups

# (S3_PROVIDER=supabase/s3/r2 ise ilgili anahtarları doldur)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Upload ──
MAX_UPLOAD_SIZE_MB=25
SIGNED_URL_EXPIRE_SECONDS=300

# ── Password reset ── (prod'da MUTLAKA false)
RESET_TOKEN_TTL_MINUTES=60
AUTH_DEV_RESET_TOKEN_RESPONSE=false
PUBLIC_COMPLAINT_LINK_TTL_DAYS=30

# ── Mail ── (opsiyonel; credentials boşsa reset tokenı teslim edilmeden iptal edilir)
# Etkinleştirildiğinde gerçek SMTP kullan; Mailhog kullanma.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=noreply@alanadi.com
APP_PUBLIC_URL=https://crm.alanadi.com

# ── Kullanıcı bazlı webmail gönderimi ──
# Haksan webmail SMTP: 587 numaralı portta STARTTLS.
USER_MAIL_ENABLED=true
USER_MAIL_SMTP_HOST=mail.haksancnc.com.tr
USER_MAIL_SMTP_PORT=587
USER_MAIL_SMTP_SECURE=false
USER_MAIL_ALLOWED_EMAIL_DOMAINS=haksancnc.com.tr
# Secret manager'da tut: openssl rand -base64 32
USER_MAIL_CREDENTIAL_ENCRYPTION_KEY=

# ── Meta Business entegrasyonu ──
# AWS secret manager/runtime env içinde doldur; image veya frontend bundle'a koyma.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_CREDENTIAL_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v25.0
META_GRAPH_BASE_URL=https://graph.facebook.com

# ── Observability (production önerilir) ──
# Sentry — 5xx ve yakalanmamış exception'lar için
SENTRY_DSN=https://CHANGE_ME@o000000.ingest.sentry.io/0000000
# OpenTelemetry — HTTP + Postgres trace (Grafana Cloud OTLP örneği)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-0.grafana.net/otlp/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64(instanceId:apiToken)
OTEL_SERVICE_NAME=haksan-api
# /metrics scrape koruması (Prometheus/Grafana Agent Bearer token)
METRICS_TOKEN=CHANGE_ME_openssl_rand_hex_32

# ── Offsite DB backup (migrate öncesi pg_dump → R2/MinIO) ──
# Yerel yedek: deploy/backup-db.sh (cron). Bu ayar R2'ye ikinci kopya atar.
DB_BACKUP_ENABLED=true
DB_BACKUP_REQUIRED=true
DB_BACKUP_TIMEOUT_SECONDS=1800

# ─────────────────────────────────────────────────────────────────────────
# FRONTEND (build anında, apps/web): SPA derlenirken set EDİLMELİ —
# çalışma anında değil. Örn:
#   VITE_API_BASE_URL=https://crm.alanadi.com/api/v1 npm run build:web
# ─────────────────────────────────────────────────────────────────────────
